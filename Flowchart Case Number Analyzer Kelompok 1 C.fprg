<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="tes flowgorihtm"/>
        <attribute name="authors" value="USER"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-17 09:07:06 PM"/>
        <attribute name="created" value="VVNFUjtMQVBUT1AtTlJIRzUySkc7MjAyNi0wOS0xNTswODoyMDo1NiBBTTsyNjU0"/>
        <attribute name="edited" value="VVNFUjtMQVBUT1AtTlJIRzUySkc7MjAyNi0wOS0xNTsxMDowNzo1NSBBTTsxOzs7OztQcm9ncmFtX0FuYWxpc2lzX0FuZ2thLmZwcmc7NTc1MQ=="/>
        <attribute name="edited" value="VVNFUjtMQVBUT1AtTlJIRzUySkc7MjAyNi0wOS0xNzswOTowNzowNiBQTTs1OzI3ODQ="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="banyakAngka" type="Integer" array="False" size=""/>
            <declare name="angka" type="Integer" array="False" size=""/>
            <declare name="jumlahPositif" type="Integer" array="False" size=""/>
            <declare name="jumlahNegatif" type="Integer" array="False" size=""/>
            <declare name="jumlahGanjil" type="Integer" array="False" size=""/>
            <declare name="jumlahGenap" type="Integer" array="False" size=""/>
            <declare name="total" type="Integer" array="False" size=""/>
            <declare name="rataRata" type="Real" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <output expression="&quot;Berapa banyak angka yang ingin dimasukkan?&quot;" newline="True"/>
            <input variable="banyakAngka"/>
            <assign variable="jumlahPositif" expression="0"/>
            <assign variable="jumlahNegatif" expression="0"/>
            <assign variable="jumlahGanjil" expression="0"/>
            <assign variable="jumlahGenap" expression="0"/>
            <assign variable="total" expression="0"/>
            <for variable="i" start="1" end="banyakAngka" direction="inc" step="1">
                <output expression="&quot;Masukkan angka&quot;" newline="True"/>
                <input variable="angka"/>
                <assign variable="total" expression="total + angka"/>
                <if expression="angka &gt;= 0">
                    <then>
                        <assign variable="jumlahPositif" expression="jumlahPositif + 1"/>
                    </then>
                    <else>
                        <assign variable="jumlahNegatif" expression="jumlahNegatif + 1"/>
                        <assign variable="angka" expression="abs (angka)"/>
                    </else>
                </if>
                <if expression="angka mod 2 = 0">
                    <then>
                        <assign variable="jumlahGenap" expression="jumlahGenap + 1"/>
                    </then>
                    <else>
                        <assign variable="jumlahGanjil" expression="jumlahGanjil + 1"/>
                    </else>
                </if>
            </for>
            <assign variable="rataRata" expression="total / banyakAngka"/>
            <output expression="&quot;Jumlah positif = &quot; &amp; jumlahPositif" newline="True"/>
            <output expression="&quot;Jumlah negatif = &quot; &amp; jumlahNegatif" newline="True"/>
            <output expression="&quot;Jumlah ganjil = &quot; &amp; jumlahGanjil" newline="True"/>
            <output expression="&quot;Jumlah genap = &quot; &amp; jumlahGenap" newline="True"/>
            <output expression="&quot;Total = &quot; &amp; total" newline="True"/>
            <output expression="&quot;Rata-rata = &quot; &amp; rataRata" newline="True"/>
        </body>
    </function>
</flowgorithm>
